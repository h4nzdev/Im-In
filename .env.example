# Google Apps Script API (Optional fallback/legacy)
VITE_GAS_API_URL=https://script.google.com/macros/s/.../exec

# Supabase Cloud Project Configuration
# Copy this file to .env and insert your project URL and public Anon Key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
